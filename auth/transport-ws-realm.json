{
  "realm": "transport-ws",
  "displayName": "Transport de marchandises",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "ADMIN"
      },
      {
        "name": "AGENT"
      },
      {
        "name": "LECTEUR"
      },
      {
        "name": "SERVICE_CHARGEMENTS"
      },
      {
        "name": "SERVICE_CAMIONS"
      },
      {
        "name": "SERVICE_BONS"
      },
      {
        "name": "SERVICE_TRANSPORTS"
      }
    ]
  },
  "clients": [
    {
      "clientId": "transport-web",
      "name": "Frontend et Postman",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*",
        "https://oauth.pstmn.io/v1/callback",
        "https://oauth.pstmn.io/v1/browser-callback"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience-chargements-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "chargements-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience-camions-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "camions-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience-bons-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "bons-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience-transports-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "transports-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "chargements-service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${CHARGEMENTS_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience-camions-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "camions-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "camions-service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${CAMIONS_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience-transports-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "transports-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "bons-service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${BONS_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience-chargements-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "chargements-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "transports-service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${TRANSPORTS_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience-camions-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "camions-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience-bons-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "bons-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-chargements-service",
      "enabled": true,
      "serviceAccountClientId": "chargements-service",
      "realmRoles": [
        "SERVICE_CHARGEMENTS"
      ]
    },
    {
      "username": "service-account-camions-service",
      "enabled": true,
      "serviceAccountClientId": "camions-service",
      "realmRoles": [
        "SERVICE_CAMIONS"
      ]
    },
    {
      "username": "service-account-bons-service",
      "enabled": true,
      "serviceAccountClientId": "bons-service",
      "realmRoles": [
        "SERVICE_BONS"
      ]
    },
    {
      "username": "service-account-transports-service",
      "enabled": true,
      "serviceAccountClientId": "transports-service",
      "realmRoles": [
        "SERVICE_TRANSPORTS"
      ]
    },
    {
      "username": "admin-ws",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "WS",
      "email": "admin@transport.example",
      "realmRoles": [
        "ADMIN"
      ],
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "${WS_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "agent-ws",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Agent",
      "lastName": "WS",
      "email": "agent@transport.example",
      "realmRoles": [
        "AGENT"
      ],
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "${WS_AGENT_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "lecteur-ws",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Lecteur",
      "lastName": "WS",
      "email": "lecteur@transport.example",
      "realmRoles": [
        "LECTEUR"
      ],
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "${WS_LECTEUR_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "client": "chargements-service",
      "roles": [
        "SERVICE_CHARGEMENTS"
      ]
    },
    {
      "client": "camions-service",
      "roles": [
        "SERVICE_CAMIONS"
      ]
    },
    {
      "client": "bons-service",
      "roles": [
        "SERVICE_BONS"
      ]
    },
    {
      "client": "transports-service",
      "roles": [
        "SERVICE_TRANSPORTS"
      ]
    }
  ]
}
