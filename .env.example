# Exemple public : remplacer ces valeurs dans l’IDE ou l’environnement du backend.
# Les quatre backends utilisent le même hôte et la même base Neon.
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_NEON_HOST:5432/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_ROLE
SPRING_DATASOURCE_PASSWORD=replace_me

# Uniquement pour la base locale facultative de compose.yaml.
LOCAL_DB_PASSWORD=replace_local_password
